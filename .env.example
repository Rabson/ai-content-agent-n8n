POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8npass
POSTGRES_DB=n8n

N8N_IMAGE=n8nio/n8n:2.11.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore

# Generate a long random value for production.
N8N_ENCRYPTION_KEY=change-this-to-a-long-random-secret

# External service environment values used in workflow nodes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

TOPIC_DISCOVERY_API_URL=https://api.tavily.com/search
TOPIC_DISCOVERY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=

DEVTO_API_URL=https://dev.to/api/articles
DEVTO_API_KEY=

# Leave empty to use: https://api.medium.com/v1/users/${MEDIUM_USER_ID}/posts
MEDIUM_API_URL=
MEDIUM_USER_ID=
MEDIUM_ACCESS_TOKEN=

# Local dashboard (status, analytics, controls)
DASHBOARD_PORT=3012
DASHBOARD_WEBHOOK_URL=http://n8n:5678/webhook/content-topic-intake
DASHBOARD_CONTROL_TOKEN=
DASHBOARD_RECENT_RUN_LIMIT=30
