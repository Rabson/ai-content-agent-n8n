      "name": "Generate approval token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const state = { ...$json };\nconst token = ($env.APPROVAL_SHARED_SECRET ?? Math.random().toString(36).slice(2, 12)).toString();\nconst callbackBase = ($env.APPROVAL_CALLBACK_URL ?? 'https://your-n8n-instance/webhook/content-approval-callback').toString();\n\nstate.approval = {\n  ...(state.approval ?? {}),\n  status: state.approval?.status && state.approval.status !== 'not_requested' ? state.approval.status : 'pending',\n  token,\n  callback_url: callbackBase,\n  requested_at: new Date().toISOString(),\n};\nstate.status = state.approval.status === 'approved' ? 'approved_for_publish' : 'awaiting_approval';\nstate.timestamps = {\n  ...(state.timestamps ?? {}),\n  updated_at: new Date().toISOString(),\n};\n\nreturn [{ json: state }];"
      }
    },
    {
      "id": "a6e40215-90ba-49cc-ac65-a57a9c1ca247",
      "name": "Persist pending approval",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        -120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO content_runs (run_id, status, topic, idempotency_key, state, updated_at)\nVALUES (\n  '{{$json.run_id}}',\n  '{{$json.status}}',\n  '{{$json.topic}}',\n  '{{ $json.idempotency_key || \"\" }}',\n  '{{ JSON.stringify($json).replace(/'/g, \"''\") }}'::jsonb,\n  NOW()\n)\nON CONFLICT (run_id)\nDO UPDATE SET\n  status = EXCLUDED.status,\n  topic = EXCLUDED.topic,\n  idempotency_key = EXCLUDED.idempotency_key,\n  state = EXCLUDED.state,\n  updated_at = NOW();",
        "options": {}
      },
      "continueOnFail": true,
      "credentials": {
        "postgres": {
          "id": "f3dc8f0f-1f70-47f5-bf25-10b0d2e55111",
          "name": "External Postgres (n8n)"
        }
      }
    },
