        "jsCode": "const out = { ...$json };\nout.status = out.approval?.status === 'approved' ? 'approved_for_publish' : (out.approval?.status === 'rejected' ? 'approval_rejected' : 'awaiting_approval');\nout.timestamps = {\n  ...(out.timestamps ?? {}),\n  updated_at: new Date().toISOString(),\n};\nreturn [{ json: out }];"
      }
