        "query": "INSERT INTO content_events (run_id, stage, level, message, payload)\nVALUES (\n  '{{$json.run_id}}',\n  '{{$json.stage}}',\n  '{{$json.level}}',\n  '{{$json.message}}',\n  '{{ JSON.stringify($json.payload).replace(/'/g, \"''\") }}'::jsonb\n);",
